# ── Server ────────────────────────────────────────────────────────────────
PORT=4000
# Comma-separated browser origins allowed to call the API (your web URL).
WEB_ORIGIN=http://localhost:3000
# Public URL of this server (used for uploaded logo URLs when IPFS is off).
PUBLIC_SERVER_URL=http://localhost:4000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────
# Empty = embedded Postgres (PGlite) stored in DATA_DIR. Set a Postgres URL in production.
DATABASE_URL=
DATA_DIR=.data

# ── Secrets (REQUIRED in production) ──────────────────────────────────────
# 32-byte hex, e.g. `openssl rand -hex 32`
JWT_SECRET=
# Encrypts custodial agent wallets. BACK IT UP: losing it locks every vault.
WALLET_ENCRYPTION_KEY=

# ── AI brain (Anthropic) ──────────────────────────────────────────────────
# Without a key the deterministic rules engine trades and chat uses templates.
ANTHROPIC_API_KEY=
# Only for keys created outside a workspace (Console → Workspaces → ID "wrkspc_…").
ANTHROPIC_WORKSPACE_ID=
# Anthropic model id, for example the current Opus. Model decisions need both the key and the model.
AI_MODEL=
# low | medium | high | xhigh | max. Low keeps per-minute decisions cheap.
AI_EFFORT=low
# Hard cap on AI decision calls per engine tick (the rest use the rules engine).
AI_MAX_CALLS_PER_TICK=8
AI_CHAT_ENABLED=true

# ── Engine ────────────────────────────────────────────────────────────────
ENGINE_ENABLED=true
ENGINE_TICK_SECONDS=60
MARKET_REFRESH_SECONDS=90

# ── Live execution from personal vaults (off by default) ─────────────────
LIVE_TRADING_ENABLED=false
# Optional: comma-separated owner wallets allowed to trade live (test phase). Empty = everyone.
LIVE_TRADING_OWNERS=
# Robinhood Chain swaps via the KyberSwap aggregator (no key needed). On whenever
# LIVE_TRADING_ENABLED=true unless switched off here.
ROBINHOOD_LIVE_ENABLED=true
KYBERSWAP_API_URL=https://aggregator-api.kyberswap.com
KYBERSWAP_CLIENT_ID=elyagents
KYBERSWAP_API_KEY=
# Uniswap v4 hooks (graduated pons pools use one) and token taxes can cost more than the quote
# shows, so buys and sells need room. Entries are checked first by simulating both legs (src/engine/route.ts).
LIVE_SLIPPAGE_BPS=1500

# ── RPC ───────────────────────────────────────────────────────────────────
# Empty = the public Robinhood Chain RPC, with publicnode and ordofi as fallbacks. They are shared
# by every user, so set a provider endpoint (Alchemy or similar) in production.
RPC_ROBINHOOD=

# ── Token launches (pons v2) ──────────────────────────────────────────────
# The live pons v2 contracts on Robinhood Chain. Change them only when pons ships a new stack.
PONS_FACTORY_ADDRESS=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
PONS_LAUNCH_AND_BUY_ADDRESS=0xe33E9E479dF8802cb0866d5d05258bEc4cF62948

# ── Uploads (optional) ────────────────────────────────────────────────────
# Pinata JWT to pin launch logos to IPFS. Empty = served from this server.
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

# ── Official token (Token & burns page) ───────────────────────────────────
OFFICIAL_TOKEN_CHAIN=robinhood
OFFICIAL_TOKEN_ADDRESS=
