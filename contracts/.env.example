# Copy to contracts/.env (never commit or upload). Foundry loads it automatically
# when run from contracts/.

# Deployer = owner of MythosLauncher (setConfig / transferOwnership). 0x-prefixed.
# Use a fresh key funded with a little ETH on Robinhood Chain, and hand ownership to a Safe afterwards.
DEPLOYER_PRIVATE_KEY=
# The public endpoint. Use https://robinhood-rpc.publicnode.com if your network intercepts it.
RPC_ROBINHOOD=https://rpc.mainnet.chain.robinhood.com
# Receives launch fees + the platform share of LP fees. Owner can change it with setConfig.
TREASURY=
# Optional overrides (defaults shown).
# LAUNCH_FEE_WEI=500000000000000
# CREATOR_FEE_BPS=6000
# START_TICK=202000
