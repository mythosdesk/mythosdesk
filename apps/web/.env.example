# URL of the Node API (apps/server)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public URL of this site (Open Graph images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional private Robinhood Chain RPC for the browser wallet (public RPCs are used when empty)
NEXT_PUBLIC_RPC_ROBINHOOD=
# Optional GMGN referral code, appended to the GMGN link on token pages
NEXT_PUBLIC_GMGN_REF=
